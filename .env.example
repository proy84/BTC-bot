# TRX bot -- copia questo file in .env e inserisci i valori reali. .env e' in .gitignore: non committarlo mai.

# Chiavi API Bybit. Con USE_TESTNET=true devono essere chiavi di Demo Trading
# (https://bybit-exchange.github.io/docs/v5/demo); con USE_TESTNET=false chiavi mainnet.
BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here

# true  -> ordini su Bybit Demo Trading (soldi finti, default sicuro).
# false -> ordini su Bybit produzione (FONDI REALI).
USE_TESTNET=true

# Opzionale: notifiche Telegram (notifier.py). Se mancano, notifiche disattivate senza errori.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
